---
import Layout from "../layouts/Layout.astro";
import HeroImage from "../components/HeroImage";
---

<Layout title="Test HeroImage">
  <div class="min-h-screen bg-gray-100 dark:bg-gray-900 p-8">
    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow-lg inline-block">
      <HeroImage client:load />
    </div>
    <!-- Debug grid overlay -->
    <div class="fixed inset-0 grid grid-cols-4 gap-4 pointer-events-none opacity-10">
      {Array(4).fill(0).map(() => (
        <div class="h-full border-l-2 border-r-2 border-blue-500"></div>
      ))}
      <div class="fixed inset-0 grid grid-rows-4 gap-4 pointer-events-none opacity-10">
        {Array(4).fill(0).map(() => (
          <div class="w-full border-t-2 border-b-2 border-blue-500"></div>
        ))}
      </div>
    </div>
  </div>
</Layout>
