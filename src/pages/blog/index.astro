---
import Layout from "../../layouts/Layout.astro";
import { motion } from "framer-motion";

const posts = [
  {
    id: 1,
    title: "Hello World",
    excerpt:
      "Welcome to my blog! This is my first post about my journey in software development.",
    date: "2024-01-15",
    slug: "hello-world",
  },
  // Add more blog posts here
];
---

<Layout title="Blog - Neil Taggart">
  <div class="min-h-screen w-full">
    <section class="py-20 w-full">
      <div class="w-full">
        <motion.div
          client:load
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.8 }}
          className="max-w-4xl mx-auto bg-white/40 dark:bg-gray-800/40 backdrop-blur-sm rounded-lg p-8"
        >
          <h1 class="font-heading text-4xl mb-8 text-primary">Blog</h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 mb-6">
            Thoughts, ideas and insights on my professional passions: software,
            leadership and tech industry.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 mb-12">
            <span class="text-gray-600 dark:text-gray-300"
              >Also featuring on:</span
            >
            <div class="flex gap-4">
              <a
                href="https://taggs.substack.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 hover:text-primary dark:text-gray-400 dark:hover:text-primary transition-colors"
                aria-label="Substack Articles"
              >
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"
                  ></path>
                </svg>
              </a>
              <a
                href="https://neiltaggart.medium.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 hover:text-primary dark:text-gray-400 dark:hover:text-primary transition-colors"
                aria-label="Medium Articles"
              >
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"
                  ></path>
                </svg>
              </a>
              <a
                href="https://www.linkedin.com/in/neiltaggart/recent-activity/articles/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 hover:text-primary dark:text-gray-400 dark:hover:text-primary transition-colors"
                aria-label="LinkedIn Articles"
              >
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>

          <div class="grid gap-8">
            {
              posts.map((post) => (
                <motion.article
                  key={post.id}
                  client:load
                  initial={{ opacity: 0 }}
                  whileInView={{ opacity: 1 }}
                  viewport={{ once: true }}
                  className="bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm p-8 rounded-lg shadow-sm hover:shadow-md transition-all duration-300"
                >
                  <a href={`/blog/${post.slug}`}>
                    <h2 class="font-heading text-2xl mb-4 text-primary hover:text-primary-dark transition-colors">
                      {post.title}
                    </h2>
                  </a>
                  <p class="text-gray-600 dark:text-gray-300 mb-4">
                    {post.excerpt}
                  </p>
                  <time class="text-sm text-gray-500 dark:text-gray-400">
                    {new Date(post.date).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                </motion.article>
              ))
            }
          </div>
        </motion.div>
      </div>
    </section>
  </div>
</Layout>
