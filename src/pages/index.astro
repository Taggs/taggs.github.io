---
import Layout from "../layouts/Layout.astro";
import AnimatedSection from "../components/AnimatedSection";
import HeroImage from "../components/HeroImage";
import ProjectCard from "../components/ProjectCard";
import RotatingQuip from "../components/RotatingQuip";
import { projects } from "../data/projects";

const building = projects.filter((p) => p.section === "building");
const writing = projects.filter((p) => p.section === "writing");
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-primary/10 to-transparent">
    <div class="mx-auto flex max-w-6xl flex-col-reverse items-center gap-10 px-5 py-16 md:flex-row md:py-24">
      <AnimatedSection client:load className="flex-1 text-center md:text-left">
        <p class="mb-4 font-mono text-sm text-primary-dark dark:text-primary">hello, world</p>
        <h1 class="text-5xl font-bold tracking-tight md:text-6xl">
          Hi, I'm Neil.
          <span class="mt-2 block text-3xl font-medium text-gray-500 dark:text-gray-400 md:text-4xl">
            I'm a technologist: writing it and writing about it.
          </span>
        </h1>
        <div class="mt-6 flex justify-center md:justify-start">
          <RotatingQuip client:load />
        </div>
        <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
          <a
            href="#building"
            class="rounded-lg bg-primary px-6 py-3 font-medium text-dark transition hover:-translate-y-0.5 hover:bg-primary-light"
          >
            Building
          </a>
          <a
            href="#writing"
            class="rounded-lg border border-gray-300 px-6 py-3 font-medium transition hover:-translate-y-0.5 hover:border-primary hover:text-primary dark:border-gray-700"
          >
            Writing
          </a>
          <a
            href="https://adaptive-online.com"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-gray-300 px-6 py-3 font-medium transition hover:-translate-y-0.5 hover:border-primary hover:text-primary dark:border-gray-700"
          >
            Pro ↗
          </a>
        </div>
        <p class="mx-auto mt-8 max-w-xl text-lg text-gray-600 dark:text-gray-300 md:mx-0">
          Games about birds, a screensaver for a planet, a bot that trades on my behalf
          and a tool that fact-checks the internet. Mostly after bedtime.
        </p>
      </AnimatedSection>

      <div class="w-64 shrink-0 animate-float sm:w-80 md:w-[400px]">
        <HeroImage client:load />
      </div>
    </div>
  </section>

  <!-- Building -->
  <section id="building" class="scroll-mt-20 py-20">
    <div class="mx-auto max-w-6xl px-5">
      <AnimatedSection client:load className="mb-12">
        <p class="font-mono text-sm text-primary-dark dark:text-primary">~/building</p>
        <h2 class="mt-2 text-4xl font-bold tracking-tight">Things I've been poking at</h2>
        <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400">
          Some are live, some are private, one is currently a cube. All of them are
          more fun than they have any right to be.
        </p>
      </AnimatedSection>

      <div class="grid gap-6 md:grid-cols-2">
        {building.map((project, index) => (
          <ProjectCard client:load project={project} index={index} />
        ))}
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section id="writing" class="scroll-mt-20 pb-20">
    <div class="mx-auto max-w-6xl px-5">
      <AnimatedSection client:load className="mb-12">
        <p class="font-mono text-sm text-primary-dark dark:text-primary">~/writing</p>
        <h2 class="mt-2 text-4xl font-bold tracking-tight">Words, in various lengths</h2>
        <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400">
          A book, a novel and a newsletter. Turns out writing code was the gateway drug.
        </p>
      </AnimatedSection>

      <div class="grid gap-6 md:grid-cols-2">
        {writing.map((project, index) => (
          <ProjectCard client:load project={project} index={index} />
        ))}
      </div>

      <AnimatedSection client:load className="mt-6">
        <a
          href="https://heuristix.substack.com"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col gap-6 rounded-2xl border border-gray-200 bg-gradient-to-br from-primary/10 via-transparent to-transparent p-8 transition-colors duration-300 hover:border-primary/60 dark:border-gray-800 md:flex-row md:items-center md:justify-between md:p-10"
        >
          <div>
            <p class="font-mono text-sm text-primary-dark dark:text-primary">~/writing/heuristix</p>
            <h2 class="mt-2 text-3xl font-bold tracking-tight">
              I think out loud at <span class="text-primary">Heuristix</span>.
            </h2>
            <p class="mt-3 max-w-xl text-gray-600 dark:text-gray-400">
              Notes on AI, software, leadership and the occasional rabbit hole.
              Rules of thumb, tested on myself first.
            </p>
          </div>
          <span class="inline-flex items-center gap-2 self-start whitespace-nowrap font-mono text-sm text-gray-700 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-primary dark:text-gray-300 md:self-center">
            heuristix.substack.com →
          </span>
        </a>
        <p class="mt-4 text-center font-mono text-xs text-gray-400 dark:text-gray-500 md:text-left">
          also occasionally on{" "}
          <a href="https://neiltaggart.medium.com/" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted underline-offset-4 hover:text-primary">Medium</a>
        </p>
      </AnimatedSection>
    </div>
  </section>

  <!-- Day job -->
  <section class="pb-8">
    <p class="mx-auto max-w-6xl px-5 text-center font-mono text-xs text-gray-400 dark:text-gray-500">
      <span class="text-primary/70">//</span> by day I help organisations adapt to technology at{" "}
      <a
        href="https://adaptive-online.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-500 underline decoration-dotted underline-offset-4 transition-colors hover:text-primary dark:text-gray-400"
      >adaptive-online.com</a>
    </p>
  </section>
</Layout>
