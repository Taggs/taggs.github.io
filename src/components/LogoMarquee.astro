---
// List of company logos and names
const companies = [
    { name: 'BBC', logo: '/logos/BBC.svg' },
    { name: 'CapCo', logo: '/logos/capco.svg' },
    { name: 'Diageo', logo: '/logos/diageo.svg' },
    { name: 'Heineken', logo: '/logos/heineken.svg' },
    { name: 'Sanofi', logo: '/logos/sanofi.svg' },
    { name: 'Figtree', logo: '/logos/figtree.svg' },
    { name: 'Tribe AI', logo: '/logos/tribeai.svg' }
];
---

<div class="bg-gray-800/90 backdrop-blur-sm py-12 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <p class="text-center text-lg text-gray-400 mb-8">Trusted by leading organizations</p>
        
        <!-- Marquee container -->
        <div class="relative">
            <!-- Gradient overlays -->
            <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-gray-800/90 to-transparent z-10"></div>
            <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-gray-800/90 to-transparent z-10"></div>
            
            <!-- Marquee content -->
            <div class="flex gap-8 animate-marquee">
                {companies.map((company) => (
                    <div class="flex-shrink-0 w-32 h-16 flex items-center justify-center">
                        <img 
                            src={company.logo} 
                            alt={`${company.name} logo`} 
                            class="h-8 w-auto brightness-0 opacity-60 hover:opacity-100 transition-opacity duration-300"
                        />
                    </div>
                ))}
                {/* Duplicate for seamless loop */}
                {companies.map((company) => (
                    <div class="flex-shrink-0 w-32 h-16 flex items-center justify-center">
                        <img 
                            src={company.logo} 
                            alt={`${company.name} logo`} 
                            class="h-8 w-auto brightness-0 opacity-60 hover:opacity-100 transition-opacity duration-300"
                        />
                    </div>
                ))}
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes marquee {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }

    .animate-marquee {
        animation: marquee 30s linear infinite;
    }

    /* Pause animation on hover */
    .animate-marquee:hover {
        animation-play-state: paused;
    }
</style>
